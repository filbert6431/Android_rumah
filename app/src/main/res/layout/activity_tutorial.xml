<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    tools:context=".Tutorial.TutorialActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/TutorialActivityViewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Menggunakan DotsIndicator sebagai satu-satunya indikator -->
    <!-- TabLayout sebelumnya dihapus karena redundan dan menyebabkan error binding -->
    <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
        android:id="@+id/dot_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        app:dotsColor="@color/abu_gelap"
        app:dotsCornerRadius="10dp"
        app:dotsSize="12dp"
        app:dotsSpacing="6dp"
        app:dotsWidthFactor="2.5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:progressMode="true"
        app:selectedDotColor="@color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
