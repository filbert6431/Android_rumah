<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fontFamily="@font/inter_variablefont_opsz"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Pertemuan_7.Home_fragment">


    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="200dp"
        android:layout_height="180dp"
        android:layout_marginStart="230dp"
        android:layout_marginTop="-100dp"
        android:backgroundTint="@color/brand_red"
        android:alpha="0.3"
        android:src="@drawable/rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="200dp"
        android:layout_height="180dp"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="@color/brand_orange"
        android:alpha="0.2"
        android:src="@drawable/rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:gravity="center"
        android:text="Welcome!"
        android:textColor="@color/text_primary"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnweb_Admin"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/brand_red"
        android:text="Halaman Admin"
        android:textAllCaps="false"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/dark_surface"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="@color/brand_red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_notifikasi" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="207dp"
        android:layout_height="183dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="520dp"
        android:backgroundTint="@color/brand_red"
        android:alpha="0.1"
        android:src="@drawable/rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="272dp"
        android:layout_height="204dp"
        android:layout_marginStart="140dp"
        android:layout_marginTop="480dp"
        android:backgroundTint="@color/brand_orange"
        android:alpha="0.15"
        android:src="@drawable/rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="fitXY"
        android:alpha="0.8"
        android:rotation="180"
        app:srcCompat="@drawable/wave"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_notifikasi"
        android:layout_width="280dp"
        android:layout_height="65dp"
        android:layout_marginTop="16dp"
        android:text="Log Aktivitas Admin"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_notifications"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/brand_red"
        app:backgroundTint="@color/dark_surface"
        app:strokeColor="@color/brand_red"
        app:strokeWidth="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnweb_Admin" />

</androidx.constraintlayout.widget.ConstraintLayout>