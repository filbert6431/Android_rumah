<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fontFamily="@font/inter_variablefont_opsz"
    tools:context=".Pertemuan_7.Home_fragment">

    <ImageView
        android:id="@+id/imageView9"
        android:layout_width="200dp"
        android:layout_height="180dp"
        android:layout_marginStart="230dp"
        android:layout_marginTop="-100dp"
        android:alpha="0.3"
        android:backgroundTint="@color/brand_red"
        android:src="@drawable/rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="200dp"
        android:layout_height="180dp"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="50dp"
        android:alpha="0.2"
        android:backgroundTint="@color/brand_orange"
        android:src="@drawable/rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="Welcome!"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnweb_Admin"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:backgroundTint="@color/brand_red"
        android:text="Halaman Admin"
        android:textAllCaps="false"
        android:textSize="16sp"
        app:cornerRadius="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView2" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_notifikasi"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="Log Aktivitas Admin"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="@color/dark_surface"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_notifications"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/brand_red"
        app:layout_constraintEnd_toEndOf="@+id/btnweb_Admin"
        app:layout_constraintStart_toStartOf="@+id/btnweb_Admin"
        app:layout_constraintTop_toBottomOf="@+id/btnweb_Admin"
        app:strokeColor="@color/brand_red"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_persil"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginTop="12dp"
        android:text="Data Persil (Tanah)"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:backgroundTint="@color/dark_surface"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_person"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/brand_orange"
        app:layout_constraintEnd_toEndOf="@+id/btn_notifikasi"
        app:layout_constraintStart_toStartOf="@+id/btn_notifikasi"
        app:layout_constraintTop_toBottomOf="@+id/btn_notifikasi"
        app:strokeColor="@color/brand_orange"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvLabelBerita"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Berita Desa Terbaru"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_persil" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RVBerita"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/imageViewWave"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvLabelBerita"
        tools:listitem="@layout/item_berita" />

    <ImageView
        android:id="@+id/imageViewWave"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:alpha="0.6"
        android:rotation="180"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/wave" />

</androidx.constraintlayout.widget.ConstraintLayout>